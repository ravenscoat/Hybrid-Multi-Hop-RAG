OLLAMA_URL=http://localhost:11434
GENERATION_MODEL=qwen3:8b
EMBEDDING_MODEL=qwen3-embedding:0.6b
INDEX_DIR=.rag_index
EMBEDDING_DIM=1024
BM25_K=30
DENSE_K=30
FUSED_K=15
RERANK_K=6
RRF_CONSTANT=60
BM25_WEIGHT=0.5
SEMANTIC_WEIGHT=0.5
VERIFY_ANSWERS=false
ENFORCE_GROUNDING=false
DOCUMENT_CONSTRAINTS=false
OLLAMA_NUM_CTX=8192
MAX_CONTEXT_CHUNKS=6
PHOENIX_ENABLED=false
PHOENIX_PROJECT_NAME=Local Hybrid RAG
# For Phoenix Cloud, also set PHOENIX_API_KEY and PHOENIX_COLLECTOR_ENDPOINT.
